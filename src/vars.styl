// Stylus aliases of the design tokens in styles/tokens.css, for the older
// components that still use stylus variables.
small-screen = 720px;
desktop-controls-width = 340px;
labels-font = 'Roboto', 'Inter', sans-serif;

highlight-color = var(--accent-text);
primary-text = var(--text);
secondary-color = var(--text-muted);
emphasis-background = var(--surface);
background-color = var(--app-bg);
border-color = var(--border);

ui-font = var(--font-ui);
muted-text = var(--text-muted);
strong-text = var(--text);
soft-background = var(--surface-2);
