small-screen = 450px;
desktop-controls-width = 442px;
labels-font = 'Roboto', sans-serif;

highlight-color = #2563eb;
primary-text = rgb(33, 33, 33);
secondary-color = rgba(0,0,0,.54);
emphasis-background = white;
background-color = #F7F2E8;
border-color = #E5E7EB;

// Shared look with the other municipal projects (Inter, blue gradient, soft cards).
ui-font = 'Inter', system-ui, 'Segoe UI', sans-serif;
brand-gradient = linear-gradient(90deg, #3a7fe8 0%, #5b6ef5 100%);
brand-gradient-hover = linear-gradient(90deg, #4a8ff8 0%, #6b7ef8 100%);
brand-shadow = 0 6px 20px rgba(74, 144, 255, 0.35);
card-background = rgba(255, 255, 255, 0.94);
card-shadow = 0 18px 48px rgba(15, 23, 42, 0.16), 0 2px 6px rgba(15, 23, 42, 0.06);
card-radius = 18px;
muted-text = #64748b;
strong-text = #0f172a;
soft-background = #F1F5F9;